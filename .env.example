# Supabase project (Project Settings → API). The publishable key is safe in the browser;
# Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase secret key (sb_secret_...). Needed only for the Claude (MCP)
# connection to look up access tokens. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Protects the daily Garmin sync cron (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Optional: dedicated key for the encrypted Garmin tokens (32 bytes, base64).
# If empty, a key is derived from SUPABASE_SECRET_KEY.
GARMIN_TOKEN_KEY=

# Optional: public URL of the deployed app (used in confirmation emails).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: USDA FoodData Central key (free: https://fdc.nal.usda.gov/api-key-signup).
# Without it the heavily rate-limited DEMO_KEY is used. Server-side only.
USDA_API_KEY=

# Optional: User-Agent sent to Open Food Facts.
OFF_USER_AGENT=PhysiqueOS/0.1 (personal nutrition tracker)
